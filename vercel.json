{
  "headers": [
    {
      "source": "/signin/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/home.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/merchant-feed/:path*",
      "destination": "https://msgqzgzoslearaprgiqq.supabase.co/functions/v1/merchant-feed/:path*"
    }
  ]
}
